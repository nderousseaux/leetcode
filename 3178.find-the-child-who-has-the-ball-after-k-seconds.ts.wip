/*
 * @lc app=leetcode id=3178 lang=typescript
 *
 * [3178] Find the Child Who Has the Ball After K Seconds
 */

// @lc code=start
function numberOfChild(n: number, k: number): number {
  return (
    Math.floor(k / (n - 1)) % 2 === 0 ?
      k % (n - 1) :
      n - (k % (n - 1)) - 1
  );
};
// @lc code=end
