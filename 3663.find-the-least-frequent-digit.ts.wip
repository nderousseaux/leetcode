/*
 * @lc app=leetcode id=3663 lang=typescript
 *
 * [3663] Find The Least Frequent Digit
 */

// @lc code=start
function getLeastFrequentDigit(n: number): number {
  let freq = new Map();
  for (let d of n.toString())
    freq.set(parseInt(d), (freq.get(parseInt(d)) ?? 0) + 1);

  return Array.from(freq).sort((a, b) => a[1] - b[1] || a[0] - b[0])[0][0]
};
// @lc code=end
