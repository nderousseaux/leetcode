/*
 * @lc app=leetcode id=3222 lang=typescript
 *
 * [3222] Find the Winning Player in Coin Game
 */

// @lc code=start
function winningPlayer(x: number, y: number): string {
  let alicePlay: boolean = false;

  while (x >= 1 && y >= 4) {
    alicePlay = !alicePlay
    x -= 1;
    y -= 4;
  }

  return alicePlay ? "Alice" : "Bob";
};
// @lc code=end
