/*
 * @lc app=leetcode id=3516 lang=typescript
 *
 * [3516] Find Closest Person
 */

// @lc code=start
function findClosest(x: number, y: number, z: number): number {
  let dist1: number = Math.abs(x - z)
  let dist2: number = Math.abs(y - z)
  if (dist1 < dist2)
    return 1;
  else if (dist1 > dist2)
    return 2;
  return 0;
};
// @lc code=end
