#
# @lc app=leetcode id=3688 lang=python3
#
# [3688] Bitwise OR of Even Numbers in an Array
#

# @lc code=start
class Solution:
    def evenNumberBitwiseORs(self, nums: List[int]) -> int:
        res: int = 0
        for n in nums:
            if n % 2 == 0:
                res |= n
        return res
# @lc code=end
