/*
 * @lc app=leetcode id=3168 lang=typescript
 *
 * [3168] Minimum Number of Chairs in a Waiting Room
 */

// @lc code=start
function minimumChairs(s: string): number {
  let ent: number = 0;
  let res: number = 0;

  for (let c of s) {
    ent += c == 'E' ? 1 : -1
    res = Math.max(res, ent);
  }
  return res;
};
// @lc code=end
