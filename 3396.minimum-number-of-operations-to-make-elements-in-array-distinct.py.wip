#
# @lc app=leetcode id=3396 lang=python3
#
# [3396] Minimum Number of Operations to Make Elements in Array Distinct
#

# @lc code=start
class Solution:
    def minimumOperations(self, nums: List[int]) -> int:
        res = 0
        while len(nums) != len(set(nums)):
            try:
                del nums[0]
                del nums[0]
                del nums[0]
            except:
                pass

            res += 1
        return res
# @lc code=end
