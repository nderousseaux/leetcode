/*
 * @lc app=leetcode id=3304 lang=typescript
 *
 * [3304] Find the K-th Character in String Game I
 */

// @lc code=start
function kthCharacter(k: number): string {

  const next = (l: string): string => String.fromCharCode((l.charCodeAt(0) + 1) % 96 + 96)

  let word: string[] = ["a"];
  while (word.length < k)
    word.push(...word.map(c => next(c)));

  return word[k - 1].charAt(0);
};
// @lc code=end
