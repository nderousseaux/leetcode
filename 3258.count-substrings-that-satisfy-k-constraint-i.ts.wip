/*
 * @lc app=leetcode id=3258 lang=typescript
 *
 * [3258] Count Substrings That Satisfy K-Constraint I
 */

// @lc code=start
function countKConstraintSubstrings(s: string, k: number): number {

  function respectK(subS: string): boolean {
    let n0: number = 0;
    let n1: number = 0;

    for (let digit of subS) {
      switch (digit) {
        case "0":
          n0++;
          break;
        case "1":
          n1++;
          break;
        default:
          throw new Error("Binary string should have only 0/1");
      }
      if (n0 > k && n1 > k) return false;
    }

    return true;
  }

  let res: number = 0;
  for (let i = 0; i < s.length; i++) {
    for (let j = i + 1; j <= s.length; j++)
      res += respectK(s.substring(i, j)) ? 1 : 0;
  }
  return res;
};
// @lc code=end
