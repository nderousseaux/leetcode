/*
 * @lc app=leetcode id=3280 lang=typescript
 *
 * [3280] Convert Date to Binary
 */

// @lc code=start
function convertDateToBinary(date: string): string {
  function subToBin(str: string, start: number = 0, end?: number): string {
    return parseInt(str.substring(start, end)).toString(2);
  }

  return `${subToBin(date, 0, 4)}-${subToBin(date, 5, 7)}-${subToBin(date, 8)}`
};
// @lc code=end
