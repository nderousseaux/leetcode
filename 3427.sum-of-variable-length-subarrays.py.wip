#
# @lc app=leetcode id=3427 lang=python3
#
# [3427] Sum of Variable Length Subarrays
#

# @lc code=start
class Solution:
    def subarraySum(self, nums: List[int]) -> int:
        res = 0
        for i, e in enumerate(nums):
            res += sum(nums[max(0, i-e):i+1])
        return res
# @lc code=end
