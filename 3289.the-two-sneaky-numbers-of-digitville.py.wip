#
# @lc app=leetcode id=3289 lang=python3
#
# [3289] The Two Sneaky Numbers of Digitville
#

# @lc code=start
class Solution:
    def getSneakyNumbers(self, nums: List[int]) -> List[int]:
        seen: set[int] = set()
        res: List[int] = []
        for v in nums:
            if v not in seen:
                seen.add(v)
            else:
                res.append(v)
        return res
# @lc code=end
