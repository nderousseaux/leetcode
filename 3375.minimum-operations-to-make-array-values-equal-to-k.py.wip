#
# @lc app=leetcode id=3375 lang=python3
#
# [3375] Minimum Operations to Make Array Values Equal to K
#

# @lc code=start
class Solution:
    def minOperations(self, nums: List[int], k: int) -> int:
        res: int = 0

        for num in set(nums):
            if num == k:
                continue
            if num < k:
                return -1

            res += 1

        return res
# @lc code=end
